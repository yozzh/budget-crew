INFERENCE=live
PUBLIC_DEMO=true
LIVE_LIMIT_PER_IP_PER_HOUR=10
LIVE_LIMIT_PER_DAY=300
OPENAI_API_KEY=
OPENAI_BASE_URL=
MOZAIK_API_KEY=
MOZAIK_PROJECT_ID=
