# Local development. Copy to .env; never commit real keys.
# live = real OpenAI models; stub = deterministic answers, no network (tests and CI always use stub).
INFERENCE=stub
OPENAI_API_KEY=
# Optional: Mozaik cloud telemetry (one session per agent loop).
MOZAIK_API_KEY=
MOZAIK_PROJECT_ID=
# Centrifugo HTTP API (deploy/compose.yaml passes the same key to Centrifugo and the app).
CENTRIFUGO_API_URL=http://127.0.0.1:8000/api
CENTRIFUGO_HTTP_API_KEY=
PORT=3000
