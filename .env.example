# Local development. Copy to .env (or run `node scripts/install.mjs`); never commit real keys.
# Read by `docker compose` (root compose.yaml) and by `pnpm start`.
# live = real OpenAI models; stub = deterministic answers, no network (tests and CI always use stub).
INFERENCE=stub
# Public demo live-inference caps; disabled for local development.
PUBLIC_DEMO=false
LIVE_LIMIT_PER_IP_PER_HOUR=10
LIVE_LIMIT_PER_DAY=300
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint. A local CLIProxyAPI with a Codex (ChatGPT) login serves
# the same gpt-6.x models on a subscription: OPENAI_BASE_URL=http://127.0.0.1:8318/v1 and its client key above.
# Inside Docker use http://host.docker.internal:8318/v1 instead of 127.0.0.1.
OPENAI_BASE_URL=
# Optional: Mozaik cloud telemetry (one session per agent loop).
MOZAIK_API_KEY=
MOZAIK_PROJECT_ID=
# Centrifugo HTTP API; compose passes the same key to Centrifugo and overrides the URL inside Docker.
CENTRIFUGO_API_KEY=budget-crew-local
CENTRIFUGO_API_URL=http://127.0.0.1:8000/api
# Host ports: the Docker stack in the browser, Centrifugo on 127.0.0.1, the API in Node mode.
APP_PORT=3000
CENTRIFUGO_PORT=8000
PORT=3000
