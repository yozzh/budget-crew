{
  "name": "budget-crew",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "start": "node --env-file-if-exists=.env apps/api/dist/main.js",
    "dev": "pnpm --filter @budget-crew/web dev",
    "wizard": "node scripts/install.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.15.0",
    "globals": "^16.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
